{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "declaration": true,
        "outDir": "dist",
        "strict": false,
        "strictNullChecks": true,
        "types": []
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "enemy/**",
        "design-docs/**",
        "content/**",
        "trigger/apply.ts",
        "trigger/dispatch.ts"
    ]
}