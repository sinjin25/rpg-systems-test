{
  "name": "rpg-tests",
  "version": "1.0.0",
  "exports": {
    "./actor2": {
      "types": "./dist/actor2/index.d.ts",
      "import": "./dist/actor2/index.js",
      "require": "./dist/actor2/index.js"
    },
    "./actor2/act": {
      "types": "./dist/actor2/act/index.d.ts",
      "import": "./dist/actor2/act/index.js",
      "require": "./dist/actor2/act/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest",
    "test:fast": "vitest --exclude \"**/*.simulation.test.ts\" --exclude \"*.simulation.test.ts\"",
    "test:slow": "vitest --passWithNoTests --testTimeout=30000 simulation.test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "vitest": "^4.1.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
