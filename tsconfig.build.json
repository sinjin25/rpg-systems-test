{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "declaration": true,
        "outDir": "dist",
        "strict": false,
        "strictNullChecks": true,
        "types": ["node"]
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "design-docs/**",
        "content/**",
        "trigger/apply.ts",
        "trigger/dispatch.ts",
        "vitest.config.ts"
    ]
}