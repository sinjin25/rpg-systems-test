{
  "name": "rpg-tests",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest",
    "test:fast": "vitest --exclude \"**/*.simulation.test.ts\" --exclude \"*.simulation.test.ts\"",
    "test:slow": "vitest --passWithNoTests --testTimeout=30000 simulation.test"
  },
